    {
      "parameters": {
        "jsCode": "const results = [];\n\nfor (const item of $input.all()) {\n  const rawText = item.json.text ?? item.json.response ?? \"\";\n\n  // Strip surrounding ```json ... ``` or ``` ... ``` fences\n  const cleaned = rawText\n    .replace(/^```(?:json)?\\s*/i, \"\")\n    .replace(/\\s*```$/i, \"\")\n    .trim();\n\n  let parsed = {};\n  try {\n    parsed = JSON.parse(cleaned);\n  } catch (err) {\n    // Fallback extraction if extra text surrounds the JSON object\n    const dishMatch = cleaned.match(/\"dish\"\\s*:\\s*\"([^\"]*)\"/);\n    const recipeMatch = cleaned.match(/\"recipe\"\\s*:\\s*\"([\\s\\S]*?)\"\\s*(?:,|\\})/);\n\n    parsed = {\n      dish: dishMatch ? dishMatch[1] : \"\",\n      recipe: recipeMatch ? recipeMatch[1] : cleaned,\n    };\n  }\n\n  const dish = typeof parsed.dish === \"string\" ? parsed.dish.trim() : \"\";\n  const recipe = typeof parsed.recipe === \"string\"\n    ? parsed.recipe.replace(/\\\\n/g, \"\\n\").trim()\n    : \"\";\n\n  // Format for Slack mrkdwn (single asterisks for bold, no HTML tags)\n  const slackMessage = dish\n    ? `*${dish}*\\n\\n${recipe}`\n    : recipe;\n\n  results.push({\n    json: {\n      dish,\n      recipe,\n      slackMessage,\n    },\n  });\n}\n\nreturn results;"
      },
