    {
      "parameters": {
        "jsCode": "const results = [];\n\nfor (const item of $input.all()) {\n  let rawText = item.json.text ?? item.json.response ?? \"\";\n\n  // Remove markdown ```json or ``` code fences if present\n  const cleaned = rawText\n    .replace(/^```(?:json)?\\s*/i, \"\")\n    .replace(/\\s*```$/i, \"\")\n    .trim();\n\n  let parsed = {};\n  try {\n    parsed = JSON.parse(cleaned);\n  } catch (err) {\n    // Fallback: extract key fields via regex if the LLM added extra prose\n    const toMatch = cleaned.match(/\"to\"\\s*:\\s*\"([^\"]+)\"/);\n    const subjectMatch = cleaned.match(/\"subject\"\\s*:\\s*\"([^\"]*)\"/);\n    const bodyMatch = cleaned.match(/\"body\"\\s*:\\s*\"([\\s\\S]*?)\"\\s*(?:,|\\})/);\n\n    parsed = {\n      to: toMatch ? toMatch[1] : \"\",\n      subject: subjectMatch ? subjectMatch[1] : \"Notification\",\n      body: bodyMatch ? bodyMatch[1] : cleaned,\n    };\n  }\n\n  // Convert literal \\n sequences into real line breaks for plain text email bodies\n  const formattedBody = typeof parsed.body === \"string\"\n    ? parsed.body.replace(/\\\\n/g, \"\\n\")\n    : \"\";\n\n  results.push({\n    json: {\n      to: parsed.to || \"\",\n      subject: parsed.subject || \"\",\n      body: formattedBody,\n    },\n  });\n}\n\nreturn results;"
      },
