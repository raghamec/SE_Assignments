    {
      "parameters": {
        "jsCode": "for (const item of $input.all()) {\n  let raw = item.json.output || \"\";\n\n  let clean = raw\n    // Convert literal escaped newlines (\\n) into actual newlines\n    .replace(/\\\\n/g, \"\\n\")\n    // Optional: strip common AI intro line if present\n    .replace(/^Certainly!.*?\\n+/i, \"\")\n    // Remove horizontal rules like --- or ___\n    .replace(/^\\s*[-_*]{3,}\\s*$/gm, \"\")\n    // Remove Markdown bold/italic (**text**, *text*, __text__)\n    .replace(/(\\*\\*|__)(.*?)\\1/g, \"$2\")\n    .replace(/(\\*|_)(.*?)\\1/g, \"$2\")\n    // Remove leading heading hashes (# Heading)\n    .replace(/^#{1,6}\\s*/gm, \"\")\n    // Collapse 3+ consecutive newlines into at most 2\n    .replace(/\\n{3,}/g, \"\\n\\n\")\n    .trim();\n\n  item.json.cleanText = clean;\n}\n\nreturn $input.all();"
      },
